# ═══════════════════════════════════════════════════════════════
# koshiv Auth Module — Environment Variables Template
# Copy this file to .env and fill with real values
# ═══════════════════════════════════════════════════════════════

# Server
APP_PORT=34554

# PostgreSQL (Tailscale)
DB_HOST=127.0.0.1
DB_PORT=34551
DB_USER=your_db_user_here
DB_PASSWORD=your_secure_password_here
DB_NAME=koshiv_kla

# Redis (Tailscale)
REDIS_HOST=127.0.0.1
REDIS_PORT=34553
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# FIDO2 / WebAuthn
RP_ID=localhost