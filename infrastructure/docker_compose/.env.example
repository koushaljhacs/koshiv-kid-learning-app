# Version 1.0.0.0.0 | Commit: _________ | Initial .env.example creation — template for docker-compose.dev.yml

# ═══════════════════════════════════════════════════════════════════════════
# Aim: Environment Variables Template for koshiv Development Stack
# Why: This file documents all required environment variables for
#      docker-compose.dev.yml. Developers must copy this to .env and fill
#      in actual values provided by the Lead Architect / DevOps team.
#      The .env file (with real credentials) is gitignored and never
#      committed. This .env.example file is safe to commit — it contains
#      only variable names and placeholder descriptions, no actual IPs,
#      ports, or credentials.
#
# Setup: cp .env.example .env  →  Fill values  →  docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════
# SECTION 1: TAILSCALE NETWORK CONFIGURATION
# All services bind exclusively to this private IP — no public exposure.
# ═══════════════════════════════════════════════════════════════

# Private Tailscale IP address assigned to this machine
KOSHIV_TAILSCALE_IP=<TAILSCALE_PRIVATE_IP>

# Docker bridge network name for inter-service communication
KOSHIV_TAILSCALE_DEV_NETWORK_NAME=<NETWORK_NAME>


# ═══════════════════════════════════════════════════════════════
# SECTION 2: POSTGRESQL 16 DATABASE SERVICE
# Core relational database — stores student profiles, learning progress,
# quiz results, and parent dashboards.
# ═══════════════════════════════════════════════════════════════

# --- Container Identity ---
KOSHIV_POSTGRES_DEV_CONTAINER_NAME=<POSTGRES_CONTAINER_NAME>
KOSHIV_POSTGRES_DEV_RESTART_POLICY=<RESTART_POLICY>

# --- Database Credentials ---
KOSHIV_POSTGRES_DEV_USER=<DATABASE_USER>
KOSHIV_POSTGRES_DEV_PASSWORD="<DATABASE_PASSWORD>"
KOSHIV_POSTGRES_DEV_DB=<DATABASE_NAME>

# --- Network Binding ---
KOSHIV_POSTGRES_DEV_PORT=<HOST_PORT>

# --- Persistent Storage ---
KOSHIV_POSTGRES_DEV_VOLUME_NAME=<VOLUME_NAME>

# --- Healthcheck Configuration ---
KOSHIV_POSTGRES_DEV_HEALTHCHECK_INTERVAL=<INTERVAL>
KOSHIV_POSTGRES_DEV_HEALTHCHECK_TIMEOUT=<TIMEOUT>
KOSHIV_POSTGRES_DEV_HEALTHCHECK_RETRIES=<RETRIES>
KOSHIV_POSTGRES_DEV_HEALTHCHECK_START_PERIOD=<START_PERIOD>

# --- Resource Allocation ---
KOSHIV_POSTGRES_DEV_CPU_LIMIT=<CPU_LIMIT>
KOSHIV_POSTGRES_DEV_MEMORY_LIMIT=<MEMORY_LIMIT>
KOSHIV_POSTGRES_DEV_CPU_RESERVATION=<CPU_RESERVATION>
KOSHIV_POSTGRES_DEV_MEMORY_RESERVATION=<MEMORY_RESERVATION>


# ═══════════════════════════════════════════════════════════════
# SECTION 3: PGADMIN4 ADMINISTRATION INTERFACE
# Web-based PostgreSQL GUI — accessible only via Tailscale private IP.
# ═══════════════════════════════════════════════════════════════

# --- Container Identity ---
KOSHIV_PGADMIN_DEV_CONTAINER_NAME=<PGADMIN_CONTAINER_NAME>
KOSHIV_PGADMIN_DEV_RESTART_POLICY=<RESTART_POLICY>

# --- Admin Credentials ---
KOSHIV_PGADMIN_DEV_EMAIL=<ADMIN_EMAIL>
KOSHIV_PGADMIN_DEV_PASSWORD="<ADMIN_PASSWORD>"

# --- Network Binding ---
KOSHIV_PGADMIN_DEV_PORT=<HOST_PORT>

# --- Persistent Storage ---
KOSHIV_PGADMIN_DEV_VOLUME_NAME=<VOLUME_NAME>

# --- Healthcheck Configuration ---
KOSHIV_PGADMIN_DEV_HEALTHCHECK_INTERVAL=<INTERVAL>
KOSHIV_PGADMIN_DEV_HEALTHCHECK_TIMEOUT=<TIMEOUT>
KOSHIV_PGADMIN_DEV_HEALTHCHECK_RETRIES=<RETRIES>
KOSHIV_PGADMIN_DEV_HEALTHCHECK_START_PERIOD=<START_PERIOD>

# --- Resource Allocation ---
KOSHIV_PGADMIN_DEV_CPU_LIMIT=<CPU_LIMIT>
KOSHIV_PGADMIN_DEV_MEMORY_LIMIT=<MEMORY_LIMIT>
KOSHIV_PGADMIN_DEV_CPU_RESERVATION=<CPU_RESERVATION>
KOSHIV_PGADMIN_DEV_MEMORY_RESERVATION=<MEMORY_RESERVATION>


# ═══════════════════════════════════════════════════════════════
# SECTION 4: REDIS 7 CACHING & SESSION STORE
# In-memory data store — session management, API caching, rate limiting.
# ═══════════════════════════════════════════════════════════════

# --- Container Identity ---
KOSHIV_REDIS_DEV_CONTAINER_NAME=<REDIS_CONTAINER_NAME>
KOSHIV_REDIS_DEV_RESTART_POLICY=<RESTART_POLICY>

# --- Redis Security ---
KOSHIV_REDIS_DEV_PASSWORD="<REDIS_PASSWORD>"

# --- Network Binding ---
KOSHIV_REDIS_DEV_PORT=<HOST_PORT>
KOSHIV_REDIS_DEV_INTERNAL_PORT=<INTERNAL_PORT>

# --- Persistence & Memory ---
KOSHIV_REDIS_DEV_AOF_FSYNC_POLICY=<FSYNC_POLICY>
KOSHIV_REDIS_DEV_MAXMEMORY=<MAX_MEMORY>
KOSHIV_REDIS_DEV_EVICTION_POLICY=<EVICTION_POLICY>
KOSHIV_REDIS_DEV_DATABASES=<DATABASE_COUNT>

# --- Connection Tuning ---
KOSHIV_REDIS_DEV_TCP_BACKLOG=<TCP_BACKLOG>
KOSHIV_REDIS_DEV_CLIENT_TIMEOUT=<CLIENT_TIMEOUT>
KOSHIV_REDIS_DEV_TCP_KEEPALIVE=<TCP_KEEPALIVE>

# --- Persistent Storage ---
KOSHIV_REDIS_DEV_VOLUME_NAME=<VOLUME_NAME>

# --- Healthcheck Configuration ---
KOSHIV_REDIS_DEV_HEALTHCHECK_INTERVAL=<INTERVAL>
KOSHIV_REDIS_DEV_HEALTHCHECK_TIMEOUT=<TIMEOUT>
KOSHIV_REDIS_DEV_HEALTHCHECK_RETRIES=<RETRIES>
KOSHIV_REDIS_DEV_HEALTHCHECK_START_PERIOD=<START_PERIOD>

# --- Resource Allocation ---
KOSHIV_REDIS_DEV_CPU_LIMIT=<CPU_LIMIT>
KOSHIV_REDIS_DEV_MEMORY_LIMIT=<MEMORY_LIMIT>
KOSHIV_REDIS_DEV_CPU_RESERVATION=<CPU_RESERVATION>
KOSHIV_REDIS_DEV_MEMORY_RESERVATION=<MEMORY_RESERVATION>